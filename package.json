{
  "name": "employee-attendance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@attendance/web",
    "dev:web": "npm run dev --workspace=@attendance/web",
    "dev:api": "npm run dev --workspace=@attendance/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace=@attendance/web",
    "build:cloudflare": "npm run db:generate && npm run build --workspace=@attendance/web",
    "dev:cloudflare": "npm run build:cloudflare && wrangler dev",
    "deploy:cloudflare": "npm run deploy:production",
    "deploy:staging": "npm run build:cloudflare && wrangler deploy --env staging",
    "deploy:production": "npm run build:cloudflare && wrangler deploy --env=",
    "cloudflare:typegen": "wrangler types cloudflare-env.d.ts",
    "load:clock-actions": "node scripts/load/clock-actions.mjs",
    "load:staging-clock-actions": "node scripts/load/staging-clock-actions.mjs",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio --schema prisma/schema.prisma"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0",
    "@types/pg": "^8.23.1",
    "prisma": "^6.19.3",
    "wrangler": "4.86.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "pg": "^8.23.1",
    "proxy-addr": "2.0.8"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "proxy-addr": "2.0.8",
    "qs": "6.16.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
