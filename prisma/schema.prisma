generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  ADMIN
  DEV_ADMIN
}

enum AttendanceStatus {
  CLOCKED_IN
  CLOCKED_OUT
}

model Client {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  worksites Worksite[]
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  passwordVersion    Int       @default(0)
  mustChangePassword Boolean   @default(false)
  role               Role      @default(EMPLOYEE)
  isActive           Boolean   @default(true)
  displayName        String?
  clientId           String?
  createdByUserId    String?
  client             Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy          User?     @relation("UserCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdUsers       User[]    @relation("UserCreator")
  employee           Employee?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([createdByUserId])
}

model Employee {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendance AttendanceRecord[]
  schedule   EmployeeSchedule?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmployeeSchedule {
  id                  String   @id @default(cuid())
  employeeId          String   @unique
  employee            Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workDays            Int[]
  startTime           String
  endTime             String
  gracePeriodMinutes  Int      @default(10)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model AttendanceRecord {
  id         String           @id @default(cuid())
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workDate   String
  clockInAt  DateTime
  clockOutAt DateTime?
  clockInLatitude  Float?
  clockInLongitude Float?
  clockInAccuracy  Float?
  clockOutLatitude  Float?
  clockOutLongitude Float?
  clockOutAccuracy  Float?
  status     AttendanceStatus @default(CLOCKED_IN)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([employeeId, workDate])
  @@index([workDate])
}

model Worksite {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name         String
  latitude     Float
  longitude    Float
  radiusMeters Int      @default(150)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([clientId, name])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  clientId    String?
  action      String
  entityType  String
  entityId    String
  details     Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([clientId, createdAt])
}
