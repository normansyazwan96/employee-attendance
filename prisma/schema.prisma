generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  ADMIN
  MANAGER
  DEV_ADMIN
}

enum PlatformRole {
  USER
  DEV_ADMIN
}

enum MembershipRole {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum AttendanceStatus {
  CLOCKED_IN
  CLOCKED_OUT
}

enum AttendanceEventType {
  CLOCK_IN
  CLOCK_OUT
  BREAK_START
  BREAK_END
}

enum AttendanceEventSource {
  MOBILE_GPS
  ADMIN_ADJUSTMENT
  MIGRATION
}

enum TimesheetState {
  OPEN
  COMPLETE
  EXCEPTION
  APPROVED
  LOCKED
}

enum WebhookDeliveryStatus {
  PENDING
  RETRYING
  DELIVERED
  DEAD_LETTER
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayPeriodStatus {
  DRAFT
  REVIEWED
  APPROVED
  LOCKED
  EXPORTED
}

enum ExportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

enum ExportFormat {
  CSV
  XLSX
}

enum PayrollJurisdiction {
  PENINSULAR_LABUAN
  SABAH
  SARAWAK
}

enum PayrollFrequency {
  MONTHLY
  SEMI_MONTHLY
  WEEKLY
}

enum PayType {
  MONTHLY
  DAILY
  HOURLY
}

enum PayrollComponentType {
  EARNING
  DEDUCTION
  ADVANCE_REPAYMENT
}

enum PayrollCalculationBasis {
  FIXED_AMOUNT
  PER_DAY
  PER_HOUR
  PERCENTAGE
}

enum PayrollCalculationStatus {
  DRAFT
  LOCKED
}

enum PayrollLineDirection {
  EARNING
  DEDUCTION
  EMPLOYER_CONTRIBUTION
}

enum EpfContributionCategory {
  STANDARD_UNDER_60
  PR_OR_PRE_1998_60_PLUS
  MALAYSIAN_60_PLUS
  NON_MALAYSIAN
  EXEMPT
}

enum SocsoContributionCategory {
  FIRST
  SECOND
  EXEMPT
}

enum PayrollAdjustmentDirection {
  EARNING
  DEDUCTION
}

enum PayrollAdjustmentDecisionOutcome {
  APPROVED
  REJECTED
}

enum PayrollStatementDeliveryStatus {
  SENT
  FAILED
}

enum PayrollLineCategory {
  BASE_PAY
  REGULAR_PAY
  OVERTIME
  REST_DAY
  PUBLIC_HOLIDAY
  PAID_LEAVE
  UNPAID_LEAVE
  ALLOWANCE
  DEDUCTION
  ADVANCE_REPAYMENT
  EPF
  SOCSO
  EIS
}

model Client {
  id                             String                              @id @default(cuid())
  name                           String
  stateCode                      String?
  isTest                         Boolean                             @default(false)
  createdAt                      DateTime                            @default(now())
  updatedAt                      DateTime                            @updatedAt
  users                          User[]
  memberships                    OrganizationMembership[]
  worksites                      Worksite[]
  attendanceEvents               AttendanceEvent[]
  timesheetDays                  TimesheetDay[]
  webhookDeliveries              WebhookDelivery[]
  departments                    Department[]
  workPolicy                     WorkPolicy?
  shiftTemplates                 ShiftTemplate[]
  holidays                       Holiday[]
  leaveTypes                     LeaveType[]
  leaveRequests                  LeaveRequest[]
  payPeriods                     PayPeriod[]
  payrollSettings                PayrollSettings?
  payrollComponents              PayrollComponent[]
  payComponentAssignments        EmployeePayComponent[]
  payrollCalculationRuns         PayrollCalculationRun[]
  payrollMonetaryAdjustments     PayrollMonetaryAdjustment[]
  payrollAdjustmentDecisions     PayrollMonetaryAdjustmentDecision[]
  payrollStatementDeliveries     PayrollStatementDelivery[]
  payrollWarningAcknowledgements PayrollWarningAcknowledgement[]
  exportJobs                     ExportJob[]
  notifications                  Notification[]
}

model User {
  id                      String                   @id @default(cuid())
  username                String                   @unique
  email                   String?                  @unique
  passwordHash            String
  passwordVersion         Int                      @default(0)
  mustChangePassword      Boolean                  @default(false)
  role                    Role                     @default(EMPLOYEE)
  platformRole            PlatformRole             @default(USER)
  isGlobalAdmin           Boolean                  @default(false)
  isActive                Boolean                  @default(true)
  failedLoginAttempts     Int                      @default(0)
  lockedUntil             DateTime?
  lastLoginAt             DateTime?
  displayName             String?
  clientId                String?
  createdByUserId         String?
  client                  Client?                  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy               User?                    @relation("UserCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdUsers            User[]                   @relation("UserCreator")
  employee                Employee?
  memberships             OrganizationMembership[]
  authSessions            AuthSession[]
  passwordResetTokens     PasswordResetToken[]
  mfaCredential           MfaCredential?
  createdAttendanceEvents AttendanceEvent[]        @relation("AttendanceEventCreator")
  ownedWorksites          Worksite[]               @relation("WorksiteOwnerAdmin")
  notifications           Notification[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@index([createdByUserId])
}

model OrganizationMembership {
  id                  String                   @id @default(cuid())
  userId              String
  clientId            String
  role                MembershipRole
  status              MembershipStatus         @default(ACTIVE)
  managerMembershipId String?
  canManagePayroll    Boolean                  @default(false)
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  client              Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  manager             OrganizationMembership?  @relation("MembershipManager", fields: [managerMembershipId], references: [id], onDelete: SetNull)
  reports             OrganizationMembership[] @relation("MembershipManager")
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@unique([userId, clientId])
  @@index([clientId, role, status])
  @@index([managerMembershipId])
}

model AuthSession {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  familyId         String
  expiresAt        DateTime
  lastUsedAt       DateTime  @default(now())
  revokedAt        DateTime?
  rotatedFromId    String?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, revokedAt, expiresAt])
  @@index([familyId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model MfaCredential {
  id              String            @id @default(cuid())
  userId          String            @unique
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  encryptedSecret String
  enabled         Boolean           @default(false)
  verifiedAt      DateTime?
  recoveryCodes   MfaRecoveryCode[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model MfaRecoveryCode {
  id              String        @id @default(cuid())
  mfaCredentialId String
  mfaCredential   MfaCredential @relation(fields: [mfaCredentialId], references: [id], onDelete: Cascade)
  codeHash        String        @unique
  usedAt          DateTime?
  createdAt       DateTime      @default(now())

  @@index([mfaCredentialId, usedAt])
}

model Employee {
  id                         String                      @id @default(cuid())
  firstName                  String
  lastName                   String
  userId                     String                      @unique
  user                       User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendance                 AttendanceRecord[]
  attendanceEvents           AttendanceEvent[]
  timesheetDays              TimesheetDay[]
  schedule                   EmployeeSchedule?
  employeeNumber             String?
  employmentStatus           EmploymentStatus            @default(ACTIVE)
  joinDate                   DateTime?
  terminationDate            DateTime?
  departmentId               String?
  department                 Department?                 @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  managerEmployeeId          String?
  manager                    Employee?                   @relation("EmployeeManager", fields: [managerEmployeeId], references: [id], onDelete: SetNull)
  directReports              Employee[]                  @relation("EmployeeManager")
  scheduleAssignments        ScheduleAssignment[]
  correctionRequests         AttendanceCorrection[]
  leaveBalances              LeaveBalance[]
  leaveRequests              LeaveRequest[]
  payProfiles                PayProfile[]
  payComponents              EmployeePayComponent[]
  payrollResults             PayrollCalculationResult[]
  statutoryProfiles          EmployeeStatutoryProfile[]
  payrollMonetaryAdjustments PayrollMonetaryAdjustment[]
  payrollStatementDeliveries PayrollStatementDelivery[]
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt

  @@index([departmentId])
  @@index([managerEmployeeId])
  @@index([employmentStatus])
}

model Department {
  id        String     @id @default(cuid())
  clientId  String
  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  isActive  Boolean    @default(true)
  employees Employee[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([clientId, name])
  @@unique([clientId, code])
}

model WorkPolicy {
  id                    String   @id @default(cuid())
  clientId              String   @unique
  client                Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  gracePeriodMinutes    Int      @default(10)
  defaultBreakMinutes   Int      @default(60)
  roundingIncrement     Int      @default(1)
  overtimeThreshold     Int      @default(480)
  maximumShiftMinutes   Int      @default(960)
  missedClockOutMinutes Int      @default(960)
  maximumGpsAccuracy    Int      @default(100)
  exactGpsRetentionDays Int      @default(90)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model ShiftTemplate {
  id                  String               @id @default(cuid())
  clientId            String
  client              Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name                String
  workDays            Int[]
  startTime           String
  endTime             String
  breakMinutes        Int                  @default(60)
  gracePeriodMinutes  Int                  @default(10)
  isOvernight         Boolean              @default(false)
  isActive            Boolean              @default(true)
  scheduleAssignments ScheduleAssignment[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([clientId, name])
  @@index([clientId, isActive])
}

model ScheduleAssignment {
  id              String        @id @default(cuid())
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftTemplateId String
  shiftTemplate   ShiftTemplate @relation(fields: [shiftTemplateId], references: [id], onDelete: Restrict)
  effectiveFrom   String
  effectiveTo     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([employeeId, effectiveFrom])
  @@index([shiftTemplateId, effectiveFrom, effectiveTo])
}

model Holiday {
  id                   String   @id @default(cuid())
  clientId             String
  client               Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date                 String
  name                 String
  stateCode            String?
  isWorkingDayOverride Boolean  @default(false)
  source               String   @default("ORGANIZATION")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([clientId, date, name])
  @@index([clientId, date])
}

model MalaysiaHoliday {
  id               String   @id @default(cuid())
  year             Int
  stateCode        String
  date             String
  name             String
  type             String   @default("public")
  importedByUserId String?
  importedAt       DateTime @default(now())

  @@unique([year, stateCode, date, name])
  @@index([year, date, stateCode])
}

model EmployeeSchedule {
  id                 String   @id @default(cuid())
  employeeId         String   @unique
  employee           Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workDays           Int[]
  startTime          String
  endTime            String
  gracePeriodMinutes Int      @default(10)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model AttendanceRecord {
  id                String           @id @default(cuid())
  employeeId        String
  employee          Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workDate          String
  clockInAt         DateTime
  clockOutAt        DateTime?
  clockInLatitude   Float?
  clockInLongitude  Float?
  clockInAccuracy   Float?
  clockOutLatitude  Float?
  clockOutLongitude Float?
  clockOutAccuracy  Float?
  status            AttendanceStatus @default(CLOCKED_IN)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([employeeId, workDate])
  @@index([workDate])
}

model AttendanceEvent {
  id                   String                @id @default(cuid())
  employeeId           String
  employee             Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  clientId             String?
  client               Client?               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  workDate             String
  type                 AttendanceEventType
  source               AttendanceEventSource @default(MOBILE_GPS)
  occurredAt           DateTime
  worksiteId           String?
  worksite             Worksite?             @relation(fields: [worksiteId], references: [id], onDelete: SetNull)
  latitude             Float?
  longitude            Float?
  accuracyMeters       Float?
  distanceMeters       Float?
  acceptedRadiusMeters Int?
  idempotencyKey       String
  createdByUserId      String?
  createdByUser        User?                 @relation("AttendanceEventCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  deviceDetails        Json?
  createdAt            DateTime              @default(now())
  webhookDelivery      WebhookDelivery?

  @@unique([employeeId, idempotencyKey])
  @@index([employeeId, workDate, occurredAt])
  @@index([clientId, workDate, occurredAt])
  @@index([worksiteId])
  @@index([createdByUserId])
}

model WebhookDelivery {
  id                String                @id @default(cuid())
  clientId          String
  client            Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  attendanceEventId String                @unique
  attendanceEvent   AttendanceEvent       @relation(fields: [attendanceEventId], references: [id], onDelete: Cascade)
  eventType         String
  payload           Json
  status            WebhookDeliveryStatus @default(PENDING)
  attempts          Int                   @default(0)
  lastAttemptAt     DateTime?
  responseStatus    Int?
  lastError         String?
  deliveredAt       DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([clientId, status, createdAt])
  @@index([status, createdAt])
}

model TimesheetDay {
  id                    String                 @id @default(cuid())
  employeeId            String
  employee              Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  clientId              String?
  client                Client?                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  workDate              String
  state                 TimesheetState         @default(OPEN)
  firstClockInAt        DateTime?
  lastClockOutAt        DateTime?
  regularMinutes        Int                    @default(0)
  overtimeMinutes       Int                    @default(0)
  breakMinutes          Int                    @default(0)
  lateMinutes           Int                    @default(0)
  earlyDepartureMinutes Int                    @default(0)
  leaveMinutes          Int                    @default(0)
  paidLeaveMinutes      Int                    @default(0)
  unpaidLeaveMinutes    Int                    @default(0)
  isAbsent              Boolean                @default(false)
  exceptionCodes        String[]               @default([])
  version               Int                    @default(1)
  approvedAt            DateTime?
  lockedAt              DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  correctionRequests    AttendanceCorrection[]
  payPeriodId           String?
  payPeriod             PayPeriod?             @relation(fields: [payPeriodId], references: [id], onDelete: SetNull)
  payrollAdjustments    PayrollAdjustment[]
  leaveAllocations      LeaveAllocation[]

  @@unique([employeeId, workDate])
  @@index([clientId, workDate, state])
  @@index([payPeriodId])
}

model AttendanceCorrection {
  id                String             @id @default(cuid())
  employeeId        String
  employee          Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  timesheetDayId    String
  timesheetDay      TimesheetDay       @relation(fields: [timesheetDayId], references: [id], onDelete: Cascade)
  reason            String
  note              String?
  originalValues    Json
  requestedValues   Json
  status            RequestStatus      @default(PENDING)
  reviewedByUserId  String?
  reviewNote        String?
  reviewedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  payrollAdjustment PayrollAdjustment?

  @@index([employeeId, status, createdAt])
  @@index([timesheetDayId, status])
}

model PayPeriod {
  id                       String                      @id @default(cuid())
  clientId                 String
  client                   Client                      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name                     String
  startDate                String
  endDate                  String
  status                   PayPeriodStatus             @default(DRAFT)
  reviewedByUserId         String?
  reviewedAt               DateTime?
  reviewedCalculationRunId String?
  approvedByUserId         String?
  approvedAt               DateTime?
  approvedCalculationRunId String?
  lockedByUserId           String?
  lockedAt                 DateTime?
  timesheetDays            TimesheetDay[]
  adjustments              PayrollAdjustment[]
  calculationRuns          PayrollCalculationRun[]
  monetaryAdjustments      PayrollMonetaryAdjustment[]
  exportJobs               ExportJob[]
  statementDeliveries      PayrollStatementDelivery[]
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt

  @@unique([clientId, startDate, endDate])
  @@index([clientId, status, startDate])
}

model PayrollSettings {
  id                            String              @id @default(cuid())
  clientId                      String              @unique
  client                        Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  jurisdiction                  PayrollJurisdiction @default(PENINSULAR_LABUAN)
  currency                      String              @default("MYR")
  payFrequency                  PayrollFrequency    @default(MONTHLY)
  normalDailyMinutes            Int                 @default(480)
  normalWeeklyMinutes           Int                 @default(2700)
  salaryDivisor                 Int                 @default(26)
  rulePackVersion               String              @default("MY-PEN-2023-01")
  statutoryContributionsEnabled Boolean             @default(false)
  statutoryRuleVersion          String              @default("MY-STAT-2025-10-01")
  createdAt                     DateTime            @default(now())
  updatedAt                     DateTime            @updatedAt
}

model PayProfile {
  id                  String   @id @default(cuid())
  employeeId          String
  employee            Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payType             PayType
  baseRateSen         Int
  normalDailyMinutes  Int
  normalWeeklyMinutes Int
  overtimeEligible    Boolean  @default(true)
  effectiveFrom       String
  effectiveTo         String?
  createdByUserId     String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([employeeId, effectiveFrom])
  @@index([employeeId, effectiveFrom, effectiveTo])
}

model EmployeeStatutoryProfile {
  id              String                    @id @default(cuid())
  employeeId      String
  employee        Employee                  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  epfCategory     EpfContributionCategory
  socsoCategory   SocsoContributionCategory
  eisEligible     Boolean                   @default(true)
  effectiveFrom   String
  effectiveTo     String?
  createdByUserId String
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@unique([employeeId, effectiveFrom])
  @@index([employeeId, effectiveFrom, effectiveTo])
}

model PayrollComponent {
  id                   String                  @id @default(cuid())
  clientId             String
  client               Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  code                 String
  name                 String
  type                 PayrollComponentType
  calculationBasis     PayrollCalculationBasis
  defaultAmountSen     Int                     @default(0)
  defaultPercentageBps Int?
  epfEligible          Boolean                 @default(true)
  socsoEligible        Boolean                 @default(true)
  eisEligible          Boolean                 @default(true)
  isActive             Boolean                 @default(true)
  assignments          EmployeePayComponent[]
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@unique([clientId, code])
  @@index([clientId, type, isActive])
}

model EmployeePayComponent {
  id                    String                   @id @default(cuid())
  clientId              String
  client                Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  employeeId            String
  employee              Employee                 @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollComponentId    String
  payrollComponent      PayrollComponent         @relation(fields: [payrollComponentId], references: [id], onDelete: Restrict)
  amountSen             Int                      @default(0)
  percentageBasisPoints Int?
  totalAmountSen        Int?
  outstandingAmountSen  Int?
  effectiveFrom         String
  effectiveTo           String?
  consentReference      String?
  notes                 String?
  isActive              Boolean                  @default(true)
  createdByUserId       String
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  calculationLines      PayrollCalculationLine[]

  @@unique([employeeId, payrollComponentId, effectiveFrom])
  @@index([clientId, employeeId, isActive])
  @@index([payrollComponentId, effectiveFrom, effectiveTo])
}

model PayrollCalculationRun {
  id                    String                     @id @default(cuid())
  clientId              String
  client                Client                     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  payPeriodId           String
  payPeriod             PayPeriod                  @relation(fields: [payPeriodId], references: [id], onDelete: Cascade)
  version               Int
  status                PayrollCalculationStatus   @default(DRAFT)
  rulePackVersion       String
  inputHash             String
  totalGrossSen         Int                        @default(0)
  totalDeductionsSen    Int                        @default(0)
  totalCalculatedPaySen Int                        @default(0)
  expectedEmployeeCount Int                        @default(0)
  warningCount          Int                        @default(0)
  blockingWarningCount  Int                        @default(0)
  calculatedByUserId    String
  lockedAt              DateTime?
  results               PayrollCalculationResult[]
  createdAt             DateTime                   @default(now())

  @@unique([payPeriodId, version])
  @@index([clientId, createdAt])
  @@index([payPeriodId, status, version])
}

model PayrollCalculationResult {
  id                       String                          @id @default(cuid())
  runId                    String
  run                      PayrollCalculationRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId               String
  employee                 Employee                        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  basePaySen               Int                             @default(0)
  regularPaySen            Int                             @default(0)
  overtimePaySen           Int                             @default(0)
  restDayPaySen            Int                             @default(0)
  publicHolidayPaySen      Int                             @default(0)
  paidLeavePaySen          Int                             @default(0)
  unpaidLeaveDeductionSen  Int                             @default(0)
  additionalEarningsSen    Int                             @default(0)
  otherDeductionsSen       Int                             @default(0)
  advanceDeductionSen      Int                             @default(0)
  epfWagesSen              Int                             @default(0)
  socsoWagesSen            Int                             @default(0)
  eisWagesSen              Int                             @default(0)
  epfEmployeeSen           Int                             @default(0)
  epfEmployerSen           Int                             @default(0)
  socsoEmployeeSen         Int                             @default(0)
  socsoEmployerSen         Int                             @default(0)
  eisEmployeeSen           Int                             @default(0)
  eisEmployerSen           Int                             @default(0)
  employerContributionsSen Int                             @default(0)
  grossPaySen              Int                             @default(0)
  totalDeductionsSen       Int                             @default(0)
  calculatedPaySen         Int                             @default(0)
  warnings                 String[]                        @default([])
  blockingWarnings         String[]                        @default([])
  payProfileSnapshot       Json?
  inputSummary             Json
  lines                    PayrollCalculationLine[]
  monetaryAdjustments      PayrollMonetaryAdjustment[]
  statementDeliveries      PayrollStatementDelivery[]
  warningAcknowledgements  PayrollWarningAcknowledgement[]
  createdAt                DateTime                        @default(now())

  @@unique([runId, employeeId])
  @@index([employeeId, createdAt])
}

model PayrollWarningAcknowledgement {
  id                     String                   @id @default(cuid())
  clientId               String
  client                 Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  calculationResultId    String
  calculationResult      PayrollCalculationResult @relation(fields: [calculationResultId], references: [id], onDelete: Cascade)
  warningCode            String
  note                   String
  acknowledgedByUserId   String
  acknowledgedByUsername String
  createdAt              DateTime                 @default(now())

  @@unique([calculationResultId, warningCode])
  @@index([clientId, createdAt])
  @@index([acknowledgedByUserId, createdAt])
}

model PayrollCalculationLine {
  id                          String                   @id @default(cuid())
  resultId                    String
  result                      PayrollCalculationResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  direction                   PayrollLineDirection
  category                    PayrollLineCategory
  code                        String
  name                        String
  amountSen                   Int
  basis                       String
  sourceComponentAssignmentId String?
  sourceComponentAssignment   EmployeePayComponent?    @relation(fields: [sourceComponentAssignmentId], references: [id], onDelete: SetNull)
  metadata                    Json?
  displayOrder                Int                      @default(0)
  createdAt                   DateTime                 @default(now())

  @@index([resultId, displayOrder])
  @@index([sourceComponentAssignmentId])
}

model PayrollMonetaryAdjustment {
  id                  String                             @id @default(cuid())
  clientId            String
  client              Client                             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  payPeriodId         String
  payPeriod           PayPeriod                          @relation(fields: [payPeriodId], references: [id], onDelete: Cascade)
  calculationResultId String
  calculationResult   PayrollCalculationResult           @relation(fields: [calculationResultId], references: [id], onDelete: Restrict)
  employeeId          String
  employee            Employee                           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  direction           PayrollAdjustmentDirection
  code                String
  name                String
  amountSen           Int
  reason              String
  createdByUserId     String
  createdAt           DateTime                           @default(now())
  decision            PayrollMonetaryAdjustmentDecision?

  @@index([clientId, payPeriodId, createdAt])
  @@index([employeeId, payPeriodId, createdAt])
  @@index([calculationResultId, createdAt])
}

model PayrollMonetaryAdjustmentDecision {
  id              String                           @id @default(cuid())
  clientId        String
  client          Client                           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  adjustmentId    String                           @unique
  adjustment      PayrollMonetaryAdjustment        @relation(fields: [adjustmentId], references: [id], onDelete: Restrict)
  outcome         PayrollAdjustmentDecisionOutcome
  note            String
  decidedByUserId String
  createdAt       DateTime                         @default(now())

  @@index([clientId, outcome, createdAt])
  @@index([decidedByUserId, createdAt])
}

model PayrollStatementDelivery {
  id                  String                         @id @default(cuid())
  clientId            String
  client              Client                         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  payPeriodId         String
  payPeriod           PayPeriod                      @relation(fields: [payPeriodId], references: [id], onDelete: Restrict)
  calculationResultId String
  calculationResult   PayrollCalculationResult       @relation(fields: [calculationResultId], references: [id], onDelete: Restrict)
  employeeId          String
  employee            Employee                       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  recipientEmail      String
  language            String                         @default("en")
  fileName            String
  status              PayrollStatementDeliveryStatus
  providerMessageId   String?
  failureReason       String?
  requestedByUserId   String
  createdAt           DateTime                       @default(now())

  @@index([clientId, payPeriodId, createdAt])
  @@index([employeeId, payPeriodId, createdAt])
  @@index([requestedByUserId, createdAt])
}

model PayrollAdjustment {
  id              String                @id @default(cuid())
  payPeriodId     String
  payPeriod       PayPeriod             @relation(fields: [payPeriodId], references: [id], onDelete: Cascade)
  timesheetDayId  String
  timesheetDay    TimesheetDay          @relation(fields: [timesheetDayId], references: [id], onDelete: Restrict)
  correctionId    String?               @unique
  correction      AttendanceCorrection? @relation(fields: [correctionId], references: [id], onDelete: SetNull)
  adjustmentType  String
  minutes         Int                   @default(0)
  reason          String
  beforeValues    Json
  afterValues     Json
  createdByUserId String
  createdAt       DateTime              @default(now())

  @@index([payPeriodId, createdAt])
  @@index([timesheetDayId])
}

model ExportJob {
  id                String          @id @default(cuid())
  clientId          String
  client            Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  payPeriodId       String
  payPeriod         PayPeriod       @relation(fields: [payPeriodId], references: [id], onDelete: Cascade)
  format            ExportFormat
  status            ExportJobStatus @default(PENDING)
  template          Json?
  r2Key             String?
  fileName          String?
  contentType       String?
  fileSizeBytes     Int?
  expiresAt         DateTime?
  lastError         String?
  requestedByUserId String
  completedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([clientId, status, createdAt])
  @@index([payPeriodId, createdAt])
}

model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId   String?
  client     Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type       String
  title      String
  message    String
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, readAt, createdAt])
  @@index([clientId, createdAt])
}

model LeaveType {
  id                        String         @id @default(cuid())
  clientId                  String
  client                    Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  code                      String
  name                      String
  isPaid                    Boolean        @default(true)
  defaultEntitlementMinutes Int            @default(0)
  isActive                  Boolean        @default(true)
  balances                  LeaveBalance[]
  requests                  LeaveRequest[]
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  @@unique([clientId, code])
}

model LeaveBalance {
  id              String    @id @default(cuid())
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId     String
  leaveType       LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  year            Int
  entitledMinutes Int       @default(0)
  usedMinutes     Int       @default(0)
  pendingMinutes  Int       @default(0)
  updatedAt       DateTime  @updatedAt

  @@unique([employeeId, leaveTypeId, year])
}

model LeaveRequest {
  id               String            @id @default(cuid())
  clientId         String
  client           Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  employeeId       String
  employee         Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId      String
  leaveType        LeaveType         @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  startDate        String
  endDate          String
  requestedMinutes Int
  reason           String?
  status           RequestStatus     @default(PENDING)
  reviewedByUserId String?
  reviewNote       String?
  reviewedAt       DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  allocations      LeaveAllocation[]

  @@index([clientId, status, startDate])
  @@index([employeeId, status, startDate])
}

model LeaveAllocation {
  id               String       @id @default(cuid())
  leaveRequestId   String
  leaveRequest     LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  timesheetDayId   String
  timesheetDay     TimesheetDay @relation(fields: [timesheetDayId], references: [id], onDelete: Restrict)
  workDate         String
  scheduledMinutes Int
  minutes          Int
  paidMinutes      Int          @default(0)
  unpaidMinutes    Int          @default(0)
  createdAt        DateTime     @default(now())

  @@unique([leaveRequestId, workDate])
  @@index([timesheetDayId])
  @@index([workDate])
}

model Worksite {
  id               String            @id @default(cuid())
  clientId         String
  client           Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  ownerAdminId     String?
  ownerAdmin       User?             @relation("WorksiteOwnerAdmin", fields: [ownerAdminId], references: [id], onDelete: Restrict)
  name             String
  stateCode        String            @default("14")
  latitude         Float
  longitude        Float
  radiusMeters     Int               @default(150)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  attendanceEvents AttendanceEvent[]

  @@index([clientId, ownerAdminId, isActive])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  clientId    String?
  action      String
  entityType  String
  entityId    String
  details     Json?
  requestId   String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([clientId, createdAt])
}
